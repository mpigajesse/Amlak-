# ============================================================
# Amlak — Template d'environnement (committé, sans secrets)
# Copier vers .env et remplir les valeurs marquées <...>
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=<générer-via-django-secret-key>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Casablanca
DJANGO_LANGUAGE_CODE=fr-fr

# --- Supabase PostgreSQL ---
# Password URL-encodé :  $ -> %24   @ -> %40   # -> %23   : -> %3A
DATABASE_URL=postgresql://<user>:<password-encoded>@<host>:5432/postgres

POSTGRES_HOST=<project-ref>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=<raw-password>
POSTGRES_SSLMODE=require

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- OCR ---
OCR_BACKEND=stub

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_LOCALE=fr-MA
